generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PublicMarketAuctionPrice {
  id           String   @id @default(dbgenerated("gen_random_uuid()::text"))
  marketId     String
  marketName   String
  companyCode  String
  tradeDate    DateTime @db.Date
  itemName     String
  quantity     Int
  minPrice     Int
  maxPrice     Int
  averagePrice Int
  sourceUrl    String
  fetchedAt    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([marketId, tradeDate, itemName])
  @@index([marketId, tradeDate(sort: Desc), itemName])
}

// ─── 사용자 ───────────────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  image                 String?
  password              String? // 이메일/비밀번호 회원가입 시 bcrypt 해시 저장 (소셜 로그인 계정은 null)
  isAdmin               Boolean   @default(false) // role 전환 기간 호환용 — 마이그레이션 완료 후 제거
  role                  UserRole  @default(CUSTOMER)
  points                Int       @default(0) // 꽃다발 후기 조합 판매 적립 포인트
  sajuName              String? // 사주 분석 시 입력한 이름 (계정 이름과 다를 수 있음)
  gender                String?
  birthDate             DateTime?
  calendarType          String?   @default("solar")
  birthHour             String?
  city                  String?
  ohaengType            String?
  lackingOhaengType     String?
  status                String    @default("ACTIVE")
  suspendedAt           DateTime?
  suspendedUntil        DateTime?
  suspendedReason       String?
  passwordResetRequired Boolean   @default(false)
  createdAt             DateTime  @default(now())

  accounts          Account[]
  orders            Order[]
  cartItems         CartItem[]
  wishlist          WishlistItem[]
  reviews           Review[]
  reviewComments    ReviewComment[]
  subscriptions     Subscription[]
  seller            Seller?
  sellerReviews     SellerReview[]     @relation("SellerReviewer")
  adminAuditLogs    AdminAuditLog[]    @relation("AdminAuditActor")
  specialDates      UserSpecialDate[]
  pointTransactions PointTransaction[]
}

model UserSpecialDate {
  id        String   @id @default(cuid())
  userId    String
  type      String
  label     String
  monthDay  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, monthDay])
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

model Account {
  id                String @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ─── 상품 ───────────────────────────────────────────

model Product {
  id                 String    @id @default(cuid())
  name               String
  description        String
  composition        String?
  sizeGuide          String?
  substitutionNotice String?
  originInfo         String?
  deliveryArea       String?
  sameDayCutoff      String?
  orderNotice        String?
  careInstructions   String?
  price              Int
  stock              Int       @default(0)
  category           String
  images             String[]
  detailImages       String[]  @default([])
  noticeImages       String[]  @default([])
  flowerMeaning      String?
  ohaengTags         String[]
  seasonTags         String[]
  colorTags          String[]
  useTags            String[]  @default([])
  deliveryDays       String[]  @default([])
  deliveryStartTime  String?
  deliveryEndTime    String?
  displayStartAt     DateTime?
  displayEndAt       DateTime?
  saleStatus         String    @default("ON_SALE")
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  sellerId           String?
  purchaseType       String    @default("INTERNAL")
  externalUrl        String?
  partnerName        String?
  partnerBadge       String?
  isPromoted         Boolean   @default(false)
  exposurePriority   Int       @default(0)
  sellerPromoted     Boolean   @default(false)
  sellerPriority     Int       @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlist   WishlistItem[]
  reviews    Review[]
  customBase CustomBase?
  seller     Seller?        @relation(fields: [sellerId], references: [id])

  @@index([sellerId, isActive])
}

model SellerProductExample {
  id        String   @id
  field     String
  category  String   @default("all")
  title     String
  content   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([field, category, sortOrder])
}

// ─── 판매처 ───────────────────────────────────────────

model Seller {
  id                    String       @id @default(cuid())
  userId                String       @unique
  status                SellerStatus @default(PENDING)
  legalBusinessName     String
  businessNumber        String       @unique
  representativeName    String
  businessType          String
  businessCategory      String
  mailOrderNumber       String?
  marketName            String
  sellerType            SellerType
  managerName           String
  managerPhone          String
  publicPhone           String?
  introduction          String?
  logoUrl               String?
  businessLicensePath   String
  postalCode            String
  roadAddress           String
  detailAddress         String
  latitude              Decimal?     @db.Decimal(10, 7)
  longitude             Decimal?     @db.Decimal(10, 7)
  businessHours         Json?
  settlementBank        String
  settlementAccount     String
  settlementHolder      String
  commissionRate        Int          @default(10)
  sellsFinishedProducts Boolean      @default(true)
  offersCustomBouquet   Boolean      @default(false)
  offersDiyFlowers      Boolean      @default(false)
  isOpen                Boolean      @default(true)
  termsVersion          String
  termsAgreedAt         DateTime
  submittedAt           DateTime     @default(now())
  approvedAt            DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  exposureWeight        Int          @default(0)
  productSortStrategy   String       @default("MANUAL")
  isCoopMember          Boolean      @default(false)
  customDeliveryScope   String       @default("NATIONWIDE")
  customDeliveryRegions String[]     @default([])
  productDeliveryScope  String       @default("NATIONWIDE")
  productDeliveryRegions String[]    @default([])

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews    SellerReview[]
  stocks     SellerStock[]
  products   Product[]
  orderItems OrderItem[]
  restockRequests RestockRequest[]

  @@index([status, isOpen])
}

model ExposurePolicy {
  id                       String   @id @default("default")
  nonghyupPriorityEnabled  Boolean  @default(true)
  preferredSellerIds       String[] @default([])
  inventoryMode            String   @default("NONE")
  adminPromotionsEnabled   Boolean  @default(true)
  sellerPoliciesEnabled    Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

model RestockRequest {
  id          String   @id
  userId      String
  sellerId    String
  flowerCodes String[]
  status      String   @default("WAITING")
  createdAt   DateTime @default(now())

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, status])
  @@index([userId, createdAt])
}

model SellerReview {
  id         String        @id @default(cuid())
  sellerId   String
  reviewerId String?
  fromStatus SellerStatus?
  toStatus   SellerStatus
  reason     String?
  snapshot   Json
  createdAt  DateTime      @default(now())

  seller   Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviewer User?  @relation("SellerReviewer", fields: [reviewerId], references: [id])

  @@index([sellerId, createdAt])
}

model SellerStock {
  id                 String    @id @default(cuid())
  sellerId           String
  flowerCode         String
  flowerName         String
  flowerMeaning      String?
  color              String?
  grade              String?
  unit               String    @default("STEM")
  quantity           Int
  unitPrice          Int
  barcode            String?
  imageUrl           String?
  availableForCustom Boolean   @default(true)
  availableForDiy    Boolean   @default(true)
  isVisible          Boolean   @default(true)
  displayStartAt     DateTime?
  displayEndAt       DateTime?
  isActive           Boolean   @default(true)
  updatedAt          DateTime  @updatedAt

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, flowerCode, color, grade])
  @@index([flowerCode, isActive])
  @@index([sellerId, isVisible, displayStartAt, displayEndAt])
}

enum SellerStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum SellerType {
  FLOWER_SHOP
  FARM
  WHOLESALE
  OTHER
}

// ─── 장바구니 ────────────────────────────────────────

model CartItem {
  id        String @id @default(cuid())
  userId    String
  productId String
  quantity  Int    @default(1)
  options   Json?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

// ─── 주문 ───────────────────────────────────────────

model Order {
  id            String      @id @default(cuid())
  userId        String? // 비회원 주문은 null — 주문번호+연락처로 /orders/lookup 조회
  status        OrderStatus @default(PENDING)
  totalAmount   Int
  shippingFee   Int         @default(0)
  deliveryType  String
  deliveryAt    DateTime?
  shippingAddr  Json
  giftMessage   String?
  giftWrapping  Boolean     @default(false)
  paymentId     String?
  paymentMethod String?
  qrCode        String?     @unique
  createdAt     DateTime    @default(now())

  user  User?       @relation(fields: [userId], references: [id])
  items OrderItem[]
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id                String    @id @default(cuid())
  orderId           String
  productId         String
  sellerId          String?
  quantity          Int
  price             Int
  itemType          String    @default("FINISHED")
  fulfillmentStatus String    @default("PAID")
  courier           String?
  trackingNumber    String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  commissionRate    Int       @default(10)
  commissionFee     Int       @default(0)
  commissionVat     Int       @default(0)
  shippingFeeAmount Int       @default(0)
  discountShare     Int       @default(0)
  pgFee             Int       @default(0)
  pgFeeVat          Int       @default(0)
  adjustmentAmount  Int       @default(0)
  settlementAmount  Int       @default(0)
  settlementStatus  String    @default("WAITING")
  settlementDueAt   DateTime?
  settledAt         DateTime?
  confirmedAt       DateTime?
  previewImageUrl   String?
  composition       Json?
  bouquetMode       String?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  seller  Seller? @relation(fields: [sellerId], references: [id])
  review  Review?

  @@index([sellerId, fulfillmentStatus])
  @@index([sellerId, settlementStatus])
}

// ─── 위시리스트 ──────────────────────────────────────

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

// ─── 리뷰 ───────────────────────────────────────────

model Review {
  id               String    @id @default(cuid())
  userId           String
  productId        String
  rating           Int
  content          String
  images           String[]
  isHidden         Boolean   @default(false)
  moderationReason String?
  moderatedAt      DateTime?
  createdAt        DateTime  @default(now())
  orderItemId      String?   @unique
  previewImageUrl  String?
  tags             String[]  @default([])
  orderMode        String?
  composition      Json?
  derivedOrderCount Int      @default(0)

  user      User       @relation(fields: [userId], references: [id])
  product   Product    @relation(fields: [productId], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])
  comments  ReviewComment[]
}

model ReviewComment {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  content   String
  parentId  String?
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  ReviewComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ReviewComment[] @relation("CommentReplies")

  @@index([reviewId, createdAt])
  @@index([parentId])
}

model PointTransaction {
  id            String   @id @default(cuid())
  userId        String
  amount        Int
  reason        String
  referenceType String
  referenceId   String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, referenceType, referenceId])
  @@index([userId, createdAt])
}

// ─── 구독 ───────────────────────────────────────────

model Subscription {
  id           String             @id @default(cuid())
  userId       String
  cycle        SubscriptionCycle
  status       SubscriptionStatus @default(ACTIVE)
  nextDelivery DateTime
  preferences  Json?
  createdAt    DateTime           @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum SubscriptionCycle {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

// ─── 꽃다발 커스텀 ───────────────────────────────────

model CustomBase {
  id         String @id @default(cuid())
  productId  String @unique
  basePrice  Int
  maxFlowers Int    @default(5)

  product Product        @relation(fields: [productId], references: [id])
  options CustomOption[]
}

model CustomOption {
  id         String @id @default(cuid())
  baseId     String
  flowerName String
  color      String
  addPrice   Int
  imageUrl   String

  base CustomBase @relation(fields: [baseId], references: [id])
}

// ─── 커스텀 꽃다발 후기 갤러리 ────────────────────────

model BouquetPost {
  id                String    @id @default(cuid())
  userId            String?
  authorName        String?
  imageUrl          String // 손님이 올린 실제 꽃다발 사진 (Vercel Blob)
  composition       Json // { sizeId, mainFlowerId, additionalFlowerIds, wrappingId }
  content           String?
  derivedOrderCount Int       @default(0) // 이 조합 그대로 구매된 횟수 — 늘어날 때마다 글쓴이 포인트 적립
  isHidden          Boolean   @default(false)
  moderationReason  String?
  moderatedAt       DateTime?
  createdAt         DateTime  @default(now())
  sourceType        String    @default("AI_COMPOSITE")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  actor User @relation("AdminAuditActor", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([targetType, targetId])
}

// ─── 오행 포토부스 (키오스크) ─────────────────────────

model KioskPhoto {
  id        String   @id @default(cuid())
  ohaeng    String // "목" | "화" | "토" | "금" | "수"
  imageUrl  String // Vercel Blob URL (합성 완료 이미지)
  createdAt DateTime @default(now())
  expiresAt DateTime // createdAt + 48h — 만료 후 /saju?kiosk= 로 조회 불가, 크론으로 삭제
}
